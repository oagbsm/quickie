{
  "name": "quick1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:phase1": "node --experimental-strip-types --experimental-default-type=module --test tests/phase1.test.ts",
    "test:turnovers": "node --experimental-strip-types --experimental-default-type=module --test tests/turnover-v1.test.ts",
    "test:str-security": "node --experimental-strip-types --experimental-default-type=module --test tests/str-security.test.ts",
    "test:auth-routing": "node --experimental-strip-types --experimental-default-type=module --test tests/cleaner-auth-routing.test.ts tests/invitation-auth.test.ts",
    "test:reservations": "node --experimental-strip-types --experimental-default-type=module --test tests/reservations.test.ts",
    "test:calendar-sync": "node --experimental-strip-types --experimental-default-type=module --test tests/calendar-sync.test.ts",
    "test:calendar-sync:integration": "node --env-file=.env.local scripts/verify-calendar-sync-e2e.mjs",
    "test:reservations:integration": "node --env-file=.env.local scripts/verify-reservations-e2e.mjs",
    "test:str-integration": "node --env-file=.env.local scripts/verify-str-e2e.mjs",
    "seed:str": "node --env-file=.env.local scripts/seed-str-v1.mjs",
    "test:e2e": "playwright test",
    "test:e2e:reservations": "RUN_RESERVATION_E2E=1 node --env-file=.env.local node_modules/@playwright/test/cli.js test tests/e2e/reservations.spec.ts --workers=1",
    "test:e2e:calendar-sync": "RUN_CALENDAR_E2E=1 node --env-file=.env.local node_modules/@playwright/test/cli.js test tests/e2e/calendar-sources.spec.ts --workers=1"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@types/leaflet": "^1.9.22",
    "browser-image-compression": "^2.0.2",
    "leaflet": "^1.9.4",
    "next": "^16.2.11",
    "postcss": "^8.5.21",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
