{
  "name": "quick1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "sandbox:check": "node --env-file=.env.test --experimental-strip-types --experimental-default-type=module scripts/marketplace-sandbox.ts check",
    "sandbox:seed": "node --env-file=.env.test --experimental-strip-types --experimental-default-type=module scripts/marketplace-sandbox.ts seed",
    "sandbox:reset": "node --env-file=.env.test --experimental-strip-types --experimental-default-type=module scripts/marketplace-sandbox.ts reset",
    "sandbox:scenarios": "node --env-file=.env.test --experimental-strip-types --experimental-default-type=module scripts/marketplace-scenarios.ts"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@types/leaflet": "^1.9.22",
    "browser-image-compression": "^2.0.2",
    "leaflet": "^1.9.4",
    "next": "^16.2.11",
    "postcss": "^8.5.21",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
